-- ===== Features =====
local antiBatConn

local function stopAntiBat()
	if antiBatConn then
		antiBatConn:Disconnect()
		antiBatConn = nil
	end
end

local function startAntiBat()
	local char = LP.Character
	if not char then return end
	local root = char:FindFirstChild("HumanoidRootPart")
	if not root then return end
	if antiBatConn then antiBatConn:Disconnect() end
	antiBatConn = RunService.Heartbeat:Connect(function()
		if not root or not root.Parent then return end
		local origXZ = Vector3.new(root.Velocity.X, 0, root.Velocity.Z)
		root.Velocity = Vector3.new(1000, root.Velocity.Y, 1000)
		RunService.RenderStepped:Wait()
		if root and root.Parent then
			root.Velocity = Vector3.new(origXZ.X, root.Velocity.Y, origXZ.Z)
		end
	end)
end

UserInputService.JumpRequest:Connect(function()
	if not State.infJump then return end
	local char = LP.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hrp and hum then
		local s = hum:GetState()
		if s == Enum.HumanoidStateType.Jumping or s == Enum.HumanoidStateType.Freefall then
			hrp.Velocity = Vector3.new(hrp.Velocity.X, 55, hrp.Velocity.Z)
		end
	end
end)

LP.CharacterAdded:Connect(function()
	task.wait(0.4)
	if State.antiBat then startAntiBat() end
end)

